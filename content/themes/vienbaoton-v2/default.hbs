<!DOCTYPE html>
<html lang="{{@site.locale}}">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{meta_title}}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap"
        rel="stylesheet">

    <link rel="stylesheet" type="text/css" href="{{asset "css/style.css"}}" />

    {{ghost_head}}
</head>

<body class="{{body_class}}">

    <div class="site-wrapper">

        <!-- Sticky Header -->
        <header class="site-header">
            <div class="header-inner">
                <div class="site-brand">
                    <a class="site-logo" href="{{@site.url}}">
                        {{#if @site.logo}}
                        <img src="{{@site.logo}}" alt="{{@site.title}}" class="logo-img-mark" />
                        {{/if}}
                        <div class="logo-text">
                            <h1>{{t "Header.site_name"}}</h1>
                            <span>{{t "Header.site_subtitle"}}</span>
                        </div>
                    </a>
                </div>
                <nav class="site-nav">
                    {{> "custom-navigation"}}
                </nav>
                <div class="header-actions">
                    <a href="/tim-kiem" class="search-toggle-btn" aria-label="{{t "Header.search_label"}}">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="11" cy="11" r="8" />
                            <path d="m21 21-4.35-4.35" />
                        </svg>
                    </a>
                    <div class="language-switcher">
                        <a href="javascript:switchLang('vi')" class="lang-btn active" id="lang-vi">VI</a>
                        <span class="lang-divider">|</span>
                        <a href="javascript:switchLang('en')" class="lang-btn" id="lang-en">EN</a>
                    </div>
                </div>
                <button class="mobile-menu-toggle" onclick="openMobileNav()" aria-label="{{t "Header.open_menu"}}">☰</button>
            </div>
        </header>

        <!-- Mobile Navigation -->
        <div id="mobile-nav-overlay" class="mobile-nav-overlay" style="display:none;" onclick="closeMobileNav()"></div>
        <div id="mobile-nav-panel" class="mobile-nav-panel" style="display:none;">
            <div class="mobile-nav-close">
                <button onclick="closeMobileNav()" aria-label="{{t "Header.close_menu"}}">✕</button>
            </div>
            <ul class="nav-menu">
                {{> "custom-navigation-mobile"}}
            </ul>
            <div class="mobile-search">
                <form class="search-form" action="/tim-kiem" method="get">
                    <div class="search-input-wrapper">
                        <input class="search-input" type="text" name="q" placeholder="{{t "Header.search_placeholder"}}" />
                        <button type="submit" class="search-submit" aria-label="{{t "Header.search_label"}}">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="11" cy="11" r="8" />
                                <path d="m21 21-4.35-4.35" />
                            </svg>
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Main Content -->
        <main class="site-main">
            {{{body}}}
        </main>

        <!-- Footer -->
        <footer class="site-footer">
            <div class="footer-inner">
                <div class="footer-columns">
                    <div class="footer-col brand-col">
                        <h3>Viện Bảo tồn Di tích</h3>
                        <p>{{t "Footer.tagline"}}</p>
                        <ul class="contact-list">
                            <li><strong>{{t "Footer.address_label"}}</strong> {{t "Footer.address"}}</li>
                            <li><strong>{{t "Footer.phone_label"}}</strong> {{t "Footer.phone"}}</li>
                            <li><strong>{{t "Footer.email_label"}}</strong> {{t "Footer.email"}}</li>
                        </ul>
                    </div>

                    <div class="footer-col links-col">
                        <h4>{{t "Footer.categories_heading"}}</h4>
                        <ul class="clean-list">
                            {{#get "tags" limit="6" filter="visibility:public" order="count.posts desc" include="count.posts"}}
                                {{#foreach tags}}
                                    <li><a href="{{url}}">{{name}} <span style="opacity:0.6; font-size:0.8rem;">({{count.posts}})</span></a></li>
                                {{/foreach}}
                            {{else}}
                                <li><a href="/">{{t "Footer.updating"}}</a></li>
                            {{/get}}
                        </ul>
                    </div>

                    <div class="footer-col links-col">
                        <h4>{{t "Footer.recent_heading"}}</h4>
                        <ul class="clean-list">
                            {{#get "posts" limit="4" filter="visibility:public"}}
                                {{#foreach posts}}
                                    <li><a href="{{url}}" title="{{title}}">{{title}}</a></li>
                                {{/foreach}}
                            {{else}}
                                <li><a href="/">{{t "Footer.preserving"}}</a></li>
                            {{/get}}
                        </ul>
                    </div>

                    <div class="footer-col links-col">
                        <h4>{{t "Footer.links_heading"}}</h4>
                        <ul class="clean-list">
                            {{navigation type="secondary"}}
                        </ul>
                    </div>
                </div>
                <div class="footer-bottom">
                    <p>&copy; {{date format="YYYY"}} <a href="{{@site.url}}">{{@site.title}}</a>. {{t "Footer.copyright"}}</p>
                </div>
            </div>
        </footer>

    </div>

    <script>
    function getLang() {
        var m = document.cookie.match(/(?:^|;\s*)vbt_lang=([^;]*)/);
        return m ? m[1] : null;
    }
    function setLang(lang) {
        document.cookie = 'vbt_lang=' + lang + ';path=/;max-age=31536000;SameSite=Lax';
    }
    function switchLang(lang) {
        setLang(lang);
        var url = new URL(window.location.href);
        if (lang === 'en') {
            url.searchParams.set('lang', 'en');
        } else {
            url.searchParams.delete('lang');
        }
        window.location.href = url.toString();
    }
    function updateLangUI() {
        var lang = new URLSearchParams(window.location.search).get('lang') || getLang() || 'vi';
        var viBtn = document.getElementById('lang-vi');
        var enBtn = document.getElementById('lang-en');
        if (viBtn && enBtn) {
            viBtn.className = 'lang-btn' + (lang === 'vi' ? ' active' : '');
            enBtn.className = 'lang-btn' + (lang === 'en' ? ' active' : '');
        }
    }
    // Redirect if cookie says EN but no lang param
    (function() {
        var saved = getLang();
        var param = new URLSearchParams(window.location.search).get('lang');
        if (saved === 'en' && param !== 'en') {
            var url = new URL(window.location.href);
            url.searchParams.set('lang', 'en');
            window.location.replace(url.toString());
            return;
        }
        if (param === 'en') { setLang('en'); }
        if (param === 'vi') {
            setLang('vi');
            var url = new URL(window.location.href);
            url.searchParams.delete('lang');
            window.location.replace(url.toString());
            return;
        }
        updateLangUI();
    })();

    function openMobileNav() {
        document.getElementById('mobile-nav-overlay').style.display = 'block';
        document.getElementById('mobile-nav-panel').style.display = 'block';
    }
    function closeMobileNav() {
        document.getElementById('mobile-nav-overlay').style.display = 'none';
        document.getElementById('mobile-nav-panel').style.display = 'none';
    }
    </script>

    {{ghost_foot}}
</body>
</html>
