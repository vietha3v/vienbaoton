                            </ul>
                        </div>
                    </div>
                </div>

                <div class="course-card">
                    <div class="course-image">
                        <img src="{{asset "images/bg2.png"}}" alt="{{t "Training.course_6_title"}}" loading="lazy" />
                    </div>
                    <div class="course-content">
                        <h3 class="course-title">{{t "Training.course_6_title"}}</h3>
                        <p class="course-description">{{t "Training.course_6_desc"}}</p>
                        <div class="course-meta">
                            <span class="course-duration">{{t "Training.course_6_duration"}}</span>
                            <span class="course-format">{{t "Training.course_6_format"}}</span>
                        </div>
                        <div class="course-topics">
                            <h4>{{t "Training.topics_heading"}}</h4>
                            <ul>
                                <li>{{t "Training.topic_6_1"}}</li>
                                <li>{{t "Training.topic_6_2"}}</li>
                                <li>{{t "Training.topic_6_3"}}</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="registration-section">
            <div class="section-header">
                <h2>{{t "Training.register_title"}}</h2>
                <p>{{t "Training.register_desc"}}</p>
            </div>
            <form class="registration-form" id="training-form">
                <div class="form-row">
                    <div class="form-group">
                        <label for="name">{{t "Training.form_name"}}</label>
                        <input type="text" id="name" name="name" placeholder="{{t "Training.form_name_ph"}}" required />
                    </div>
                    <div class="form-group">
                        <label for="email">{{t "Training.form_email"}}</label>
                        <input type="email" id="email" name="email" placeholder="{{t "Training.form_email_ph"}}" required />
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label for="phone">{{t "Training.form_phone"}}</label>
                        <input type="tel" id="phone" name="phone" placeholder="{{t "Training.form_phone_ph"}}" />
                    </div>
                    <div class="form-group">
                        <label for="org">{{t "Training.form_org"}}</label>
                        <input type="text" id="org" name="org" placeholder="{{t "Training.form_org_ph"}}" />
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label for="position">{{t "Training.form_position"}}</label>
                        <input type="text" id="position" name="position" placeholder="{{t "Training.form_position_ph"}}" />
                    </div>
                    <div class="form-group">
                        <label for="course">{{t "Training.form_course"}}</label>
                        <select id="course" name="course">
                            <option value="">{{t "Training.form_course_select"}}</option>
                            <option>{{t "Training.course_1_title"}}</option>
                            <option>{{t "Training.course_2_title"}}</option>
                            <option>{{t "Training.course_3_title"}}</option>
                            <option>{{t "Training.course_4_title"}}</option>
                            <option>{{t "Training.course_5_title"}}</option>
                            <option>{{t "Training.course_6_title"}}</option>
                        </select>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group full-width">
                        <label for="message">{{t "Training.form_message"}}</label>
                        <textarea id="message" name="message" rows="4" placeholder="{{t "Training.form_message_ph"}}"></textarea>
                    </div>
                </div>
                <div class="form-submit">
                    <button type="submit" class="btn-primary">{{t "Training.form_submit"}}</button>
                </div>
            </form>
            <div class="form-success" id="form-success" style="display:none;">
                <div class="success-icon">&check;</div>
                <h3>{{t "Training.success_title"}}</h3>
                <p>{{t "Training.success_msg"}}</p>
            </div>
        </div>
    </div>
</div>

<script>
(function() {
    // Use same-origin in production, localhost:3001 in dev (Ghost runs on :2368)
    var API_URL = window.location.port === '2368'
        ? 'http://localhost:3001/api/training-register'
        : '/api/training-register';
    var form = document.getElementById('training-form');
    var success = document.getElementById('form-success');
    var submitBtn = form.querySelector('button[type="submit"]');

    form.addEventListener('submit', function(e) {
        e.preventDefault();

        var data = {
            name: document.getElementById('name').value.trim(),
            email: document.getElementById('email').value.trim(),
            phone: document.getElementById('phone').value.trim(),
            org: document.getElementById('org').value.trim(),
            position: document.getElementById('position').value.trim(),
            course: document.getElementById('course').value,
            message: document.getElementById('message').value.trim()
        };

        if (!data.name || !data.email) {
            alert('Vui lòng điền họ tên và email');
            return;
        }

        submitBtn.disabled = true;
        submitBtn.textContent = 'Đang gửi...';

        fetch(API_URL, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        })
        .then(function(res) { return res.json(); })
        .then(function(result) {
            if (result.success) {
                form.style.display = 'none';
                success.style.display = 'block';
                success.scrollIntoView({ behavior: 'smooth' });
            } else {
                alert(result.error || 'Có lỗi xảy ra, vui lòng thử lại');
                submitBtn.disabled = false;
                submitBtn.textContent = '{{t "Training.form_submit"}}';
            }
        })
        .catch(function() {
            alert('Không thể kết nối đến máy chủ. Vui lòng thử lại sau.');
            submitBtn.disabled = false;
            submitBtn.textContent = '{{t "Training.form_submit"}}';
        });
    });
})();
</script>
