{{!< default}}
<div class="training-page">
    <div class="page-header">
        <div class="page-header-inner">
            <h1 class="page-title">{{t "Training.title"}}</h1>
            <p class="page-subtitle">{{t "Training.subtitle"}}</p>
        </div>
    </div>

    <div class="training-intro">
        <div class="page-container">
            <div class="intro-content">
                <h2>{{t "Training.intro_title"}}</h2>
                <p>{{t "Training.intro_desc"}}</p>
            </div>
        </div>
    </div>

    <div class="page-container">
        <div class="training-courses">
            <div class="section-header">
                <h2>{{t "Training.courses_heading"}}</h2>
            </div>
            <div class="courses-grid">
                <div class="course-card">
                    <div class="course-image">
                        <img src="{{asset "images/background.jpg"}}" alt="{{t "Training.course_1_title"}}" loading="lazy" />
                    </div>
                    <div class="course-content">
                        <h3 class="course-title">{{t "Training.course_1_title"}}</h3>
                        <p class="course-description">{{t "Training.course_1_desc"}}</p>
                        <div class="course-meta">
                            <span class="course-duration">{{t "Training.course_1_duration"}}</span>
                            <span class="course-format">{{t "Training.course_1_format"}}</span>
                        </div>
                        <div class="course-topics">
                            <h4>{{t "Training.topics_heading"}}</h4>
                            <ul>
                                <li>{{t "Training.topic_1_1"}}</li>
                                <li>{{t "Training.topic_1_2"}}</li>
                                <li>{{t "Training.topic_1_3"}}</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <div class="course-card">
                    <div class="course-image">
                        <img src="{{asset "images/bg2.png"}}" alt="{{t "Training.course_2_title"}}" loading="lazy" />
                    </div>
                    <div class="course-content">
                        <h3 class="course-title">{{t "Training.course_2_title"}}</h3>
                        <p class="course-description">{{t "Training.course_2_desc"}}</p>
                        <div class="course-meta">
                            <span class="course-duration">{{t "Training.course_2_duration"}}</span>
                            <span class="course-format">{{t "Training.course_2_format"}}</span>
                        </div>
                        <div class="course-topics">
                            <h4>{{t "Training.topics_heading"}}</h4>
                            <ul>
                                <li>{{t "Training.topic_2_1"}}</li>
                                <li>{{t "Training.topic_2_2"}}</li>
                                <li>{{t "Training.topic_2_3"}}</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <div class="course-card">
                    <div class="course-image">
                        <img src="{{asset "images/bg3.png"}}" alt="{{t "Training.course_3_title"}}" loading="lazy" />
                    </div>
                    <div class="course-content">
                        <h3 class="course-title">{{t "Training.course_3_title"}}</h3>
                        <p class="course-description">{{t "Training.course_3_desc"}}</p>
                        <div class="course-meta">
                            <span class="course-duration">{{t "Training.course_3_duration"}}</span>
                            <span class="course-format">{{t "Training.course_3_format"}}</span>
                        </div>
                        <div class="course-topics">
                            <h4>{{t "Training.topics_heading"}}</h4>
                            <ul>
                                <li>{{t "Training.topic_3_1"}}</li>
                                <li>{{t "Training.topic_3_2"}}</li>
                                <li>{{t "Training.topic_3_3"}}</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <div class="course-card">
                    <div class="course-image">
                        <img src="{{asset "images/bg.png"}}" alt="{{t "Training.course_4_title"}}" loading="lazy" />
                    </div>
                    <div class="course-content">
                        <h3 class="course-title">{{t "Training.course_4_title"}}</h3>
                        <p class="course-description">{{t "Training.course_4_desc"}}</p>
                        <div class="course-meta">
                            <span class="course-duration">{{t "Training.course_4_duration"}}</span>
                            <span class="course-format">{{t "Training.course_4_format"}}</span>
                        </div>
                        <div class="course-topics">
                            <h4>{{t "Training.topics_heading"}}</h4>
                            <ul>
                                <li>{{t "Training.topic_4_1"}}</li>
                                <li>{{t "Training.topic_4_2"}}</li>
                                <li>{{t "Training.topic_4_3"}}</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <div class="course-card">
                    <div class="course-image">
                        <img src="{{asset "images/background.jpg"}}" alt="{{t "Training.course_5_title"}}" loading="lazy" />
                    </div>
                    <div class="course-content">
                        <h3 class="course-title">{{t "Training.course_5_title"}}</h3>
                        <p class="course-description">{{t "Training.course_5_desc"}}</p>
                        <div class="course-meta">
                            <span class="course-duration">{{t "Training.course_5_duration"}}</span>
                            <span class="course-format">{{t "Training.course_5_format"}}</span>
                        </div>
                        <div class="course-topics">
                            <h4>{{t "Training.topics_heading"}}</h4>
                            <ul>
                                <li>{{t "Training.topic_5_1"}}</li>
                                <li>{{t "Training.topic_5_2"}}</li>
